#!/usr/bin/env python3
"""wordpass: generate memorable passwords from adjective-noun pairs you can picture."""
import argparse
import os
import secrets
import subprocess
import sys
import tempfile
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "wordpass"
NOUNS_PATH = Path(os.environ["WORDPASS_NOUNS"]) if os.environ.get("WORDPASS_NOUNS") else None
ADJECTIVES_PATH = Path(os.environ["WORDPASS_ADJECTIVES"]) if os.environ.get("WORDPASS_ADJECTIVES") else None
HISTORY_PATH = STATE_DIR / "history.txt"
DEFAULT_SEPARATOR = "-"
MAX_ATTEMPTS = 100

