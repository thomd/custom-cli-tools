def parse_history_size() -> int:
    raw = os.environ.get("WORDPASS_HISTORY_SIZE", "40")
    try:
        size = int(raw)
    except ValueError:
        sys.exit(f"error: WORDPASS_HISTORY_SIZE={raw!r} is not an integer")
    if size < 0:
        sys.exit(f"error: WORDPASS_HISTORY_SIZE={size} must be >= 0")
    return size


def parse_words(raw: str) -> list[str]:
    words = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        words.append(line.split()[-1])
    return words


def _looks_like_a_word(w: str) -> bool:
    return w.isascii() and bool(w) and all(c.isalpha() or c == "-" for c in w) and w[0] != "-" and w[-1] != "-"


def _load_words(path: Path, env_var: str) -> list[str]:
    if not path.exists():
        sys.exit(f"error: {env_var}={path} does not exist")
    words = parse_words(path.read_text(encoding="utf-8-sig"))
    if not words or not all(_looks_like_a_word(w) for w in words):
        sys.exit(f"error: wordlist at {path} contains no usable words")
    return words


def ensure_nouns() -> list[str]:
    # WORDPASS_NOUNS overrides the built-in noun list entirely, e.g. for tests or
    # a custom list. Never modified -- a small fixture file used for testing must
    # survive untouched.
    if NOUNS_PATH is not None:
        return _load_words(NOUNS_PATH, "WORDPASS_NOUNS")
    return list(BUILTIN_NOUNS)


def ensure_adjectives() -> list[str]:
    if ADJECTIVES_PATH is not None:
        return _load_words(ADJECTIVES_PATH, "WORDPASS_ADJECTIVES")
    return list(BUILTIN_ADJECTIVES)


def load_history() -> list[str]:
    if not HISTORY_PATH.exists():
        return []
    return HISTORY_PATH.read_text(encoding="utf-8").splitlines()


def append_history(password: str) -> None:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    # mkdir(mode=...) is a no-op on a dir that already exists, so enforce it every call too.
    os.chmod(STATE_DIR, 0o700)
    fd = os.open(HISTORY_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        f.write(password + "\n")


def trim_history(max_size: int) -> None:
    if not HISTORY_PATH.exists():
        return
    lines = HISTORY_PATH.read_text(encoding="utf-8").splitlines()
    if len(lines) <= max_size:
        return
    trimmed = lines[-max_size:] if max_size > 0 else []
    fd, tmp_path = tempfile.mkstemp(dir=STATE_DIR)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(trimmed) + ("\n" if trimmed else ""))
    os.chmod(tmp_path, 0o600)
    os.replace(tmp_path, HISTORY_PATH)


def _format(adj_words: list[str], noun: str, digits: str, separator: str, capitalize: bool) -> str:
    def word(w: str) -> str:
        return w.capitalize() if capitalize else w.lower()

    return separator.join([word(a) for a in adj_words] + [word(noun), digits])


def generate_one(adjectives: list[str], nouns: list[str], separator: str, capitalize: bool, length: int) -> str:
    # Base pattern: {adjective}{separator}{noun}{separator}{number}
    adj1 = secrets.choice(adjectives)
    noun = secrets.choice(nouns)
    digits = secrets.choice("0123456789")
    password = _format([adj1], noun, digits, separator, capitalize)
    if len(password) >= length:
        return password

    # Too short: escalate to {adjective}{separator}{adjective}{separator}{noun}{separator}{number}
    # -- a second, distinct adjective adds length via another visualizable word,
    # which serves the "memorable" goal better than just padding the number.
    remaining_adj = [a for a in adjectives if a != adj1] or adjectives
    adj2 = secrets.choice(remaining_adj)
    password = _format([adj2, adj1], noun, digits, separator, capitalize)

    # Last resort, only reachable with a very large --length: keep appending
    # successor digits to the number segment until long enough.
    while len(password) < length:
        digits += secrets.choice("0123456789")
        password = _format([adj2, adj1], noun, digits, separator, capitalize)
    return password


def generate_unique(adjectives, nouns, separator, capitalize, length, seen: set) -> str:
    for _ in range(MAX_ATTEMPTS):
        candidate = generate_one(adjectives, nouns, separator, capitalize, length)
        if candidate not in seen:
            return candidate
    sys.exit(
        f"error: could not generate a new password after {MAX_ATTEMPTS} attempts.\n"
        "Lower WORDPASS_HISTORY_SIZE, or add more words via WORDPASS_NOUNS/WORDPASS_ADJECTIVES."
    )


def copy_to_clipboard(text: str) -> None:
    try:
        subprocess.run(["pbcopy"], input=text.encode(), check=True)
    except (FileNotFoundError, subprocess.CalledProcessError) as e:
        print(f"warning: could not copy to clipboard ({e})", file=sys.stderr)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="wordpass", description="Generate memorable {adjective}{sep}{noun}{sep}{number} passwords."
    )
    parser.add_argument("-c", "--count", type=int, default=1, help="number of passwords to generate")
    parser.add_argument("-l", "--length", type=int, default=14, help="minimum total password length")
    parser.add_argument(
        "-s", "--symbol",
        default=DEFAULT_SEPARATOR, metavar="CHAR",
        help=f"separator between adjective, noun, and number (default: '{DEFAULT_SEPARATOR}')",
    )
    parser.add_argument("--capitalize", action="store_true", help="capitalize the adjective and noun (default: lowercase)")
    parser.add_argument("--no-clipboard", action="store_true", help="don't copy to clipboard")
    args = parser.parse_args()

    if args.count < 1:
        parser.error("--count must be >= 1")
    if args.length < 1:
        parser.error("--length must be >= 1")
    if len(args.symbol) != 1 or not args.symbol.isprintable() or args.symbol.isspace():
        parser.error("--symbol must be a single printable, non-whitespace character")

    history_size = parse_history_size()
    adjectives = ensure_adjectives()
    nouns = ensure_nouns()
    seen = set(load_history())

    generated = []
    try:
        for _ in range(args.count):
            pw = generate_unique(adjectives, nouns, args.symbol, args.capitalize, args.length, seen)
            seen.add(pw)
            generated.append(pw)
            append_history(pw)
            print(pw)
    finally:
        # Always trim, even on the exhaustion sys.exit() above (SystemExit still
        # runs a finally) -- otherwise a failed run leaves history permanently
        # over WORDPASS_HISTORY_SIZE until some later successful run trims it.
        trim_history(history_size)

    skip_clipboard = args.no_clipboard or len(generated) > 1 or not sys.stdout.isatty()
    if skip_clipboard:
        if len(generated) > 1 and not args.no_clipboard:
            print("(clipboard skipped: multiple passwords generated)", file=sys.stderr)
    else:
        copy_to_clipboard(generated[0])


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # e.g. `wordpass -c 50 | head -1` -- suppress the traceback noise from
        # writing to a closed pipe; redirect stdout to /dev/null first so Python's
        # own shutdown flush doesn't raise the same error a second time.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(1)
